<mxfile host="app.diagrams.net">
  <diagram id="ccflow" name="Cross-chain flow">
    <mxGraphModel dx="1500" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1500" pageHeight="860" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============== LANE BACKGROUNDS ============== -->
        <mxCell id="laneA" value="CHAIN A  —  token của SWAPPER" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#F3F5FA;strokeColor=#C6CBD9;strokeWidth=1;verticalAlign=top;align=center;fontSize=17;fontStyle=1;fontColor=#16305C;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="80" width="690" height="590" as="geometry" />
        </mxCell>
        <mxCell id="laneB" value="CHAIN B  —  token của FILLER" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#9FB6D9;strokeWidth=1;verticalAlign=top;align=center;fontSize=17;fontStyle=1;fontColor=#16305C;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="770" y="80" width="690" height="590" as="geometry" />
        </mxCell>

        <!-- ============== ACTORS ============== -->
        <mxCell id="swapper" value="SWAPPER" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16305C;strokeWidth=2;fontColor=#16305C;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="110" y="150" width="230" height="76" as="geometry" />
        </mxCell>
        <mxCell id="filler" value="FILLER — giữ secret S" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#16305C;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="600" y="150" width="300" height="76" as="geometry" />
        </mxCell>

        <!-- ============== ESCROWS ============== -->
        <mxCell id="esrc" value="EscrowSrc  (clone CREATE2)&#10;&#10;giữ INPUT của swapper&#10;+ BOND của filler" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16305C;strokeWidth=2;fontColor=#16305C;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="400" width="330" height="130" as="geometry" />
        </mxCell>
        <mxCell id="edst" value="EscrowDst  (clone CREATE2)&#10;&#10;giữ OUTPUT trả cho swapper" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16305C;strokeWidth=2;fontColor=#16305C;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1050" y="400" width="330" height="130" as="geometry" />
        </mxCell>

        <!-- ============== HASHLOCK (center link) ============== -->
        <mxCell id="hlock" value="HASHLOCK H&#10;H = keccak256(S)" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#16305C;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="655" y="425" width="190" height="80" as="geometry" />
        </mxCell>
        <mxCell id="hl_s" style="edgeStyle=none;html=1;dashed=1;endArrow=none;strokeColor=#8A93A6;strokeWidth=2;" edge="1" parent="1" source="hlock" target="esrc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="hl_d" style="edgeStyle=none;html=1;dashed=1;endArrow=none;strokeColor=#8A93A6;strokeWidth=2;" edge="1" parent="1" source="hlock" target="edst">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============== SECRET + RELAYER ============== -->
        <mxCell id="secret" value="secret S&#10;(công khai)" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#C89B2E;strokeWidth=2;fontColor=#8A6D1A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="560" y="585" width="170" height="60" as="geometry" />
        </mxCell>
        <mxCell id="relayer" value="RELAYER" style="rounded=1;arcSize=16;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16305C;strokeWidth=2;fontColor=#16305C;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="810" y="585" width="150" height="60" as="geometry" />
        </mxCell>

        <!-- ============== NUMBERED FLOW EDGES ============== -->
        <mxCell id="s1" value="①  fund EscrowDst — khoá output" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16305C;strokeWidth=2;fontSize=14;fontColor=#16305C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="filler" target="edst">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s2" value="②  verify EscrowDst thật → ký FillAuth  (Điểm A)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16305C;strokeWidth=2;fontSize=14;fontColor=#16305C;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="swapper" target="esrc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s3" value="③  fillSlot — khoá input + bond" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16305C;strokeWidth=2;fontSize=14;fontColor=#16305C;labelBackgroundColor=#FFFFFF;exitX=0;exitY=0.5;exitDx=0;exitDy=0;entryX=1;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="filler" target="esrc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s4" value="④  withdraw → lộ secret S" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C89B2E;strokeWidth=2;fontSize=14;fontColor=#8A6D1A;labelBackgroundColor=#FFFFFF;exitX=0.5;exitY=1;exitDx=0;exitDy=0;entryX=0.5;entryY=0;entryDx=0;entryDy=0;" edge="1" parent="1" source="esrc" target="secret">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s45" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#C89B2E;strokeWidth=2;" edge="1" parent="1" source="secret" target="relayer">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="s5" value="⑤  claim(S) → swapper nhận OUTPUT" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16305C;strokeWidth=2;fontSize=14;fontColor=#16305C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0.5;entryY=1;entryDx=0;entryDy=0;" edge="1" parent="1" source="relayer" target="edst">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============== BO CUOC CALLOUT ============== -->
        <mxCell id="grief" value="✗  Filler bỏ cuộc (không lộ S):&#10;quá T1 → cancel EscrowSrc&#10;→ swapper hoàn INPUT + BOND" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FBEDEE;strokeColor=#C8102E;strokeWidth=1;fontColor=#C8102E;fontSize=13;align=left;verticalAlign=middle;spacingLeft=14;" vertex="1" parent="1">
          <mxGeometry x="120" y="560" width="330" height="90" as="geometry" />
        </mxCell>

        <!-- ============== TIMELINE ============== -->
        <mxCell id="tl" value="" style="endArrow=block;html=1;strokeColor=#16305C;strokeWidth=3;fontSize=13;" edge="1" parent="1">
          <mxGeometry relative="1" as="geometry">
            <mxPoint x="120" y="740" as="sourcePoint" />
            <mxPoint x="1380" y="740" as="targetPoint" />
          </mxGeometry>
        </mxCell>
        <mxCell id="t0" value="bây giờ" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16305C;strokeWidth=1;fontColor=#16305C;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="120" y="716" width="120" height="48" as="geometry" />
        </mxCell>
        <mxCell id="t1" value="T1 — cancel EscrowSrc&#10;(swapper hoàn input + bond)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16305C;strokeWidth=1;fontColor=#16305C;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="520" y="710" width="240" height="60" as="geometry" />
        </mxCell>
        <mxCell id="t2" value="T2 — refund EscrowDst&#10;(chỉ filler)" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16305C;strokeWidth=1;fontColor=#16305C;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="710" width="220" height="60" as="geometry" />
        </mxCell>
        <mxCell id="buf" value="buffer  ≥  finality chain đích" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#5B6472;fontSize=13;fontStyle=2;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="770" width="320" height="30" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
