<mxfile host="app.diagrams.net" type="device"><diagram id="slide1" name="1. Xây dựng DEX Aggregator theo mô hình Int"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="1-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="1-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="1-t" value="Xây dựng DEX Aggregator theo mô hình Intent —&lt;br&gt;Partial-fill &amp;amp; Filler permissionless (NeutronX)" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="1-b" value="&lt;div style='font-size:16px;margin-top:40px'&gt;&lt;p&gt;SVTH: [Tên] — MSSV: [...]&lt;/p&gt;&lt;p&gt;GVHD: [Tên GVHD]&lt;/p&gt;&lt;p style='margin-top:30px'&gt;Tháng .../2026&lt;/p&gt;&lt;/div&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide2" name="2. Nội dung"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="2-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="2-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="2-t" value="Nội dung" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="2-b" value="&lt;ul style='margin:0 0 0 18px;padding:0'&gt;&lt;li style='margin:4px 0'&gt;Bài toán&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Mục tiêu đồ án&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Thiết kế hệ thống&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Kiểm thử&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Kết luận và hướng phát triển&lt;/li&gt;&lt;/ul&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide3" name="3. Bài toán: từ AMM aggregator đến mô hình "><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="3-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="3-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="3-t" value="Bài toán: từ AMM aggregator đến mô hình Intent" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="3-b" value="&lt;table style='width:100%;font-size:13px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;width:50%'&gt;&lt;b&gt;Aggregator truyền thống&lt;/b&gt;&lt;ul style='margin:0 0 0 18px;padding:0'&gt;&lt;li style='margin:4px 0'&gt;Người dùng tự gửi giao dịch qua các pool AMM&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Tự chịu slippage, dễ bị sandwich&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Giao dịch có thể thất bại nhưng vẫn mất gas&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top;width:50%'&gt;&lt;b&gt;Mô hình Intent&lt;/b&gt;&lt;ul style='margin:0 0 0 18px;padding:0'&gt;&lt;li style='margin:4px 0'&gt;Người dùng ký intent: đổi X, nhận tối thiểu Y&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Filler lo thực thi và gánh rủi ro&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Gasless, được đảm bảo mức output tối thiểu&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p style='font-size:13px;margin-top:8px'&gt;Mô hình phổ biến hiện nay: một order do một filler khớp trọn.&lt;/p&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide4" name="4. Khoảng trống và mục tiêu đồ án"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="4-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="4-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="4-t" value="Khoảng trống và mục tiêu đồ án" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="4-b" value="&lt;table style='border-collapse:collapse;font-size:12px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;UniswapX&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;1inch Fusion&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;CoW Swap&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Fill&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;all-or-nothing&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;partial-fill&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;batch&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Filler&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;permissionless&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;KYC + whitelist&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;bonding + KYC&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Hệ quả&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;order lớn chờ lâu&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;rào cản filler&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;rào cản filler&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;div style='margin-top:10px;font-size:13px'&gt;&lt;b&gt;Mục tiêu:&lt;/b&gt;&lt;ul style='margin:0 0 0 18px;padding:0'&gt;&lt;li style='margin:4px 0'&gt;Order khớp nhanh nhờ nhiều filler cùng partial-fill&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Filler permissionless — không whitelist, ràng buộc bằng stake&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Vẫn an toàn khi mở cửa: chặn ôm-rồi-bỏ và gian lận&lt;/li&gt;&lt;/ul&gt;&lt;/div&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide5" name="5. Kiến trúc tổng thể"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="5-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="5-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="5-t" value="Kiến trúc tổng thể" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="5-b" value="&lt;ul style='margin:0 0 0 18px;padding:0'&gt;&lt;li style='margin:4px 0'&gt;&lt;b&gt;Frontend&lt;/b&gt;: người dùng ký order; dashboard filler&lt;/li&gt;&lt;li style='margin:4px 0'&gt;&lt;b&gt;Backend&lt;/b&gt;: orderbook, cosigner ký giá, watcher trạng thái, relayer&lt;/li&gt;&lt;li style='margin:4px 0'&gt;&lt;b&gt;Settlement layer (on-chain)&lt;/b&gt;: hai nhánh — single-chain và cross-chain&lt;/li&gt;&lt;li style='margin:4px 0'&gt;&lt;b&gt;Filler&lt;/b&gt;: agent off-chain, bất kỳ ai chạy được&lt;/li&gt;&lt;/ul&gt;&lt;p style='font-size:13px'&gt;Oracle định giá collateral là contract on-chain trong settlement layer.&lt;/p&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide6" name="6. Single-chain swap: các contract"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="6-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="6-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="6-t" value="Single-chain swap: các contract" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="6-b" value="&lt;table style='border-collapse:collapse;font-size:12px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Contract&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Vai trò&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;PartialFillReactor&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Giữ remaining, khớp từng chunk, chuyển token qua Permit2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;FillAuction&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Giữ stake filler; hoàn stake / slash&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;DynamicStakeLib&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Công thức tính stake và hoàn cọc theo bucket&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;FallbackExecutor&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Sát deadline chưa xong thì route qua aggregator khác&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide7" name="7. Cơ chế permissionless: đặt cọc (stake)"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="7-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="7-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="7-t" value="Cơ chế permissionless: đặt cọc (stake)" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="7-b" value="&lt;p style='font-size:13px'&gt;Không whitelist — ràng buộc bằng stake. Muốn khớp phải stake; ôm order rồi bỏ thì mất stake.&lt;/p&gt;&lt;p style='font-size:13px'&gt;&lt;b&gt;stake = giá trị order × rate(size) × multiplier(thời gian)&lt;/b&gt;, có sàn minCollateral.&lt;/p&gt;&lt;table style='border-collapse:collapse;font-size:12px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Order size&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;rate&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Thời gian còn lại&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;multiplier&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;nhỏ / vừa / lớn&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;thấp → cao&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;còn nhiều → sắp hết&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;1× → 5×&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p style='font-size:12px;margin-top:6px'&gt;Refund theo % fill so với cam kết: fill nhỏ → hoàn ít; fill ≥70% → hoàn đủ.&lt;/p&gt;&lt;p style='font-size:12px'&gt;Ngưỡng kinh tế (worst-case): chọn tham số sao cho mọi kiểu fill-một-phần-rồi-bỏ đều không có lời.&lt;/p&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide8" name="8. Ngưỡng kinh tế: cách tính worst-case"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="8-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="8-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="8-t" value="Ngưỡng kinh tế: cách tính worst-case" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="8-b" value="&lt;p style='font-size:13px'&gt;Snipe có lời khi: chênh giá ăn được &amp;gt; cọc bị tịch thu &amp;nbsp; (x·N·κ &amp;gt; S·(1−φ)).&lt;/p&gt;&lt;p style='font-size:14px'&gt;&lt;b&gt;κ (bps) = collateralRate × timeMult × penalty / (10000 × x)&lt;/b&gt;&lt;/p&gt;&lt;ul style='margin:0 0 0 18px;padding:0'&gt;&lt;li style='margin:4px 0'&gt;penalty = 10000 − refund_bps (phần cọc bị mất)&lt;/li&gt;&lt;li style='margin:4px 0'&gt;x = % fill tại mép bucket bị phạt cuối cùng&lt;/li&gt;&lt;li style='margin:4px 0'&gt;worstCaseKappa = min qua mọi (size × thời gian × bucket); config nhận nếu ≥ 1000 bps (10%)&lt;/li&gt;&lt;/ul&gt;&lt;p style='font-size:13px;margin-top:6px'&gt;&lt;b&gt;Ví dụ (config mặc định):&lt;/b&gt; order nhỏ (rate 2000), nhiều thời gian (mult 10000), dừng sát mép 70%:&lt;br&gt;κ = 2000 × 10000 × 5000 / (10000 × 7000) ≈ 1429 bps ≈ 14,3% → phải ăn &amp;gt;14% chênh giá mới có lời → an toàn.&lt;/p&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide9" name="9. Luồng single-chain swap"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="9-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="9-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="9-t" value="Luồng single-chain swap" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="9-b" value="&lt;ul style='margin:0 0 0 18px;padding:0'&gt;&lt;li style='margin:4px 0'&gt;Người dùng ký order (một lần)&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Filler đặt stake và register&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Filler fill từng chunk → chuyển token cho người dùng → được hoàn stake&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Nhiều filler cùng fill phần còn lại; remaining giảm về 0&lt;/li&gt;&lt;/ul&gt;&lt;p style='font-size:13px'&gt;Nhánh phụ: sát deadline chưa xong thì fallback route qua aggregator; filler ôm stake rồi bỏ bị bất kỳ ai slash.&lt;/p&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide10" name="10. Cross-chain swap: các contract"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="10-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="10-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="10-t" value="Cross-chain swap: các contract" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="10-b" value="&lt;table style='width:100%;font-size:13px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;width:50%'&gt;&lt;b&gt;Chain A (token người dùng)&lt;/b&gt;&lt;ul style='margin:0 0 0 18px;padding:0'&gt;&lt;li style='margin:4px 0'&gt;EscrowSrc: giữ input + bond filler&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Expiry T1&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top;width:50%'&gt;&lt;b&gt;Chain B (token filler)&lt;/b&gt;&lt;ul style='margin:0 0 0 18px;padding:0'&gt;&lt;li style='margin:4px 0'&gt;EscrowDst: giữ output filler nạp&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Expiry T2&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p style='font-size:13px'&gt;Cùng một hashlock H; ràng buộc T1 &amp;lt; T2. Mỗi fill một cặp escrow riêng (CREATE2). Filler tự giữ secret.&lt;/p&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide11" name="11. Luồng cross-chain swap"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="11-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="11-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="11-t" value="Luồng cross-chain swap" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="11-b" value="&lt;ul style='margin:0 0 0 18px;padding:0'&gt;&lt;li style='margin:4px 0'&gt;Filler nạp EscrowDst trên chain B trước&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Người dùng verify EscrowDst rồi ký cho phép mở EscrowSrc&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Filler withdraw EscrowSrc lấy token — hành động này làm lộ secret&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Relayer dùng secret claim EscrowDst, trả token cho người dùng&lt;/li&gt;&lt;/ul&gt;&lt;p style='font-size:13px'&gt;Nếu filler bỏ cuộc: sau T1 cancel EscrowSrc → người dùng nhận lại input + bond; sau T2 chỉ filler tự refund EscrowDst. Không double-dip.&lt;/p&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide12" name="12. Thiết kế động cơ: T1, T2 và bond"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="12-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="12-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="12-t" value="Thiết kế động cơ: T1, T2 và bond" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="12-b" value="&lt;ul style='margin:0 0 0 18px;padding:0'&gt;&lt;li style='margin:4px 0'&gt;&lt;b&gt;T1 &amp;lt; T2&lt;/b&gt; ép on-chain: nếu ngược lại người dùng có thể ăn hai đầu (contract chặn t2 ≤ t1)&lt;/li&gt;&lt;li style='margin:4px 0'&gt;&lt;b&gt;Buffer T1→T2&lt;/b&gt; dựa trên finality: đủ dài để sau khi secret lộ, relayer kịp claim trước khi chain có thể reorg&lt;/li&gt;&lt;li style='margin:4px 0'&gt;&lt;b&gt;Bond&lt;/b&gt; đủ lớn để fill-rồi-bỏ không có lời → filler chọn hoàn thành là hợp lý&lt;/li&gt;&lt;/ul&gt;&lt;p style='font-size:12px'&gt;Finality = mốc giao dịch được đảm bảo không bị đảo. Đây là giả định phi-mật-mã duy nhất, phải đặt buffer thận trọng.&lt;/p&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide13" name="13. Rủi ro còn lại ở người dùng và filler"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="13-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="13-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="13-t" value="Rủi ro còn lại ở người dùng và filler" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="13-b" value="&lt;table style='border-collapse:collapse;font-size:12px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Bên&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Rủi ro&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Giảm thiểu&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Người dùng&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Ký khi EscrowDst chưa final rồi bị reorg&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Verify + chờ chain đích final rồi mới ký&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Người dùng&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Relayer dừng, không tự nhận output&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Tự claim (secret đã public), miễn trước T2&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Filler&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Nạp EscrowDst trước, người dùng không ký&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Khoá vốn tạm, refund sau T2 (mất gas, không mất gốc)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide14" name="14. Kiểm thử: phương pháp và kết quả"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="14-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="14-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="14-t" value="Kiểm thử: phương pháp và kết quả" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="14-b" value="&lt;ul style='margin:0 0 0 18px;padding:0'&gt;&lt;li style='margin:4px 0'&gt;Công cụ: Foundry — đơn vị, fuzz, invariant&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Môi trường: fork mainnet (định giá pool thật) + hai chuỗi Anvil cho cross-chain&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Kết quả: 173/173 trường hợp đạt&lt;/li&gt;&lt;/ul&gt;&lt;table style='border-collapse:collapse;font-size:12px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Nhóm&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Số test&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Mục đích&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Thư viện nền&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;44&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Toán stake/hoàn cọc, bucket, decay, remaining&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Governance &amp;amp; guard&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;42&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Đổi cấu hình trong giới hạn an toàn, phân quyền&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Đối kháng / MEV&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;24&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Front-run, snipe, ôm-rồi-bỏ, forgery, reentrancy&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Khớp lệnh, cọc &amp;amp; dự phòng&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;44&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;register/slash/hoàn cọc, partial-fill, fallback&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Cross-chain&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;17&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;T2&amp;gt;T1, không double-dip, hashlock một lần&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Fuzz / invariant&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;2&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Order luôn settle, bất biến solvency&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;&lt;b&gt;Tổng&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;&lt;b&gt;173&lt;/b&gt;&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;+ 4 test oracle TWAP trên fork&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide15" name="15. Rà soát bảo mật và phân tích tĩnh"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="15-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="15-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="15-t" value="Rà soát bảo mật và phân tích tĩnh" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="15-b" value="&lt;table style='border-collapse:collapse;font-size:12px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Phương pháp&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Kết quả&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Slither (tĩnh)&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;101 detector / 34 contract / 32 cảnh báo; 4 sửa; 0 khai thác được&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Mutation (Vertigo-rs)&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;4 thư viện, 20 mutant; bổ sung test biên → 20/20&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Trufy (audit độc lập)&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;8 phát hiện (3C/4TB/1T); 3 sửa; phần cross-chain xử lý khi thiết kế lại&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p style='font-size:12px;margin-top:6px'&gt;Thí nghiệm TWAP (mức sụt cọc): cửa sổ 60s = −21% / −100%; cửa sổ 1800s = −1,5% / −81% (tấn công 30M / 300M USDC).&lt;/p&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide16" name="16. Kiểm thử đối kháng: filler gian lận"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="16-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="16-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="16-t" value="Kiểm thử đối kháng: filler gian lận" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="16-b" value="&lt;table style='border-collapse:collapse;font-size:12px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Kịch bản&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Cơ chế trong code&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Đăng ký rồi bỏ, không fill&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;slash() sau deadline+50 block, order còn dở, chưa huỷ; thưởng stake/10&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Thua cuộc đua fill&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;releaseRegistration() hoàn đủ stake khi order đã xong; tách khỏi bỏ dở&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Sửa startPrice đã ký&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;startPrice trong hash EIP-712; recover ≠ cosigner → revert&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Token output gọi đệ quy&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;nonReentrant + thứ tự checks-effects-interactions&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide17" name="17. Kiểm thử cơ chế hoàn stake"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="17-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="17-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="17-t" value="Kiểm thử cơ chế hoàn stake" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="17-b" value="&lt;table style='border-collapse:collapse;font-size:12px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Kịch bản&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Cơ chế trong code&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Bị fill chen ngang 11%, còn 89%&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;onFillSuccess() mẫu số = min(cam kết, còn lại lúc fill) → hoàn đủ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Ba mức hoàn theo % giao&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;computeRefund() tra bảng snapshot lúc register, tỉ lệ trên cam kết&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Fill nhỏ / chặn fill vụn&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Tỉ lệ theo cam kết; minFillBps do người dùng đặt&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Admin nới lỏng luật cọc&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;validate + guardCheck (±20%, sàn phạt 5%) + hoãn 7 ngày + rollback&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide18" name="18. Kiểm thử cross-chain"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="18-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="18-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="18-t" value="Kiểm thử cross-chain" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="18-b" value="&lt;table style='border-collapse:collapse;font-size:12px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Kịch bản&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Cơ chế trong code&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Đặt t2 ≤ t1&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;fillSlot() yêu cầu t2 &amp;gt; t1 (ép on-chain)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Filler bỏ cuộc&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;cancel() trả input+bond cho người dùng; refund chỉ filler; claim trả người dùng&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Tái dùng hashlock&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;salt CREATE2 keccak256(orderHash,hashlock) trùng địa chỉ → revert&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Fill bị huỷ, mở lại&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;restoreRemaining() xác thực bằng địa chỉ CREATE2, kẹp trần, một lần&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide19" name="19. So sánh gas và mô hình phía filler (4 hệ"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="19-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="19-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="19-t" value="So sánh gas và mô hình phía filler (4 hệ)" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="19-b" value="&lt;p style='font-size:12px'&gt;Người dùng gasless ở cả 4 hệ. Chỉ NeutronX là số đo thật; các cột khác là ước tính kiến trúc (*).&lt;/p&gt;&lt;table style='border-collapse:collapse;font-size:12px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;UniswapX&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;1inch&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;CoW&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;NeutronX (đo)&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Fill single&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;all-or-nothing&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;partial-fill&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;batch&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;partial-fill&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Quyền filler&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;permissionless&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;KYC+stake&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;bonding+KYC&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;permissionless&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Gas single&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;~120–200k*&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;~150–250k*&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;thấp (batch)*&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;reg ~410k + fill ~235k&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Cross-chain&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;ERC-7683+Across&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Fusion+ HTLC&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;bridge ngoài&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;HTLC filler-key&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Niềm tin CC&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;relayer Across&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;relayer (atomic)&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;bridge ngoài&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;không bên thứ 3&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Gas CC&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;~200–350k*&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;~400–700k*&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;bridge+swap*&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;~720k (đo)&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p style='font-size:12px;margin-top:6px'&gt;NeutronX là hệ duy nhất kết hợp permissionless + partial-fill + cross-chain atomic không cầu nối, đổi lại gas filler cao hơn.&lt;/p&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide20" name="20. Kết luận: đối chiếu mục tiêu"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="20-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="20-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="20-t" value="Kết luận: đối chiếu mục tiêu" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="20-b" value="&lt;table style='border-collapse:collapse;font-size:12px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Mục tiêu&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Kết quả&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Partial-fill đấu giá Hà Lan&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;PartialFillReactor, mỗi phần định giá độc lập&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Ký off-chain EIP-712 + Permit2&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Ký bằng ví, gasless khi tạo order&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Stake động ràng buộc filler&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;FillAuction, phân biệt thua cuộc / bỏ dở&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Cơ chế dự phòng hoàn tất&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;FallbackExecutor (Uniswap, KyberSwap)&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Cross-chain không cầu nối, partial-fill&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;HTLC filler-holds-key, mỗi fill một escrow&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p style='font-size:13px'&gt;Đóng góp chính: stake ràng buộc filler và cross-chain có partial-fill.&lt;/p&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide21" name="21. Hạn chế và hướng phát triển"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="21-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="21-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="21-t" value="Hạn chế và hướng phát triển" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="21-b" value="&lt;table style='width:100%;font-size:13px'&gt;&lt;tr&gt;&lt;td style='vertical-align:top;width:50%'&gt;&lt;b&gt;Hạn chế&lt;/b&gt;&lt;ul style='margin:0 0 0 18px;padding:0'&gt;&lt;li style='margin:4px 0'&gt;Mới kiểm thử trên mạng giả lập&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Filler cấp vốn không giới hạn, chưa phản ánh kinh tế mainnet&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Điểm tập trung: cosigner (single-chain) và backend&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Phạm vi hẹp: cross-chain chỉ EVM; dự phòng hai sàn&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;td style='vertical-align:top;width:50%'&gt;&lt;b&gt;Hướng phát triển&lt;/b&gt;&lt;ul style='margin:0 0 0 18px;padding:0'&gt;&lt;li style='margin:4px 0'&gt;Lên testnet + kiểm toán chuyên gia trước mainnet&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Phi tập trung cosigner bằng TEE&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Nới cửa sổ TWAP + thêm nguồn giá độc lập&lt;/li&gt;&lt;li style='margin:4px 0'&gt;Thêm bộ chuyển đổi 1inch, 0x; mở rộng nhiều chuỗi EVM → non-EVM&lt;/li&gt;&lt;/ul&gt;&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram><diagram id="slide22" name="22. Vai trò backend"><mxGraphModel dx="800" dy="600" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1280" pageHeight="720" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="22-bg" value="" style="rounded=0;fillColor=#ffffff;strokeColor=#cccccc;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="720" as="geometry"/></mxCell><mxCell id="22-bar" value="" style="fillColor=#1f3c88;strokeColor=none;" vertex="1" parent="1"><mxGeometry x="0" y="0" width="1280" height="8" as="geometry"/></mxCell><mxCell id="22-t" value="Vai trò backend" style="text;html=1;fontSize=24;fontStyle=1;fontColor=#1f3c88;align=left;verticalAlign=middle;whiteSpace=wrap;" vertex="1" parent="1"><mxGeometry x="50" y="30" width="1180" height="70" as="geometry"/></mxCell><mxCell id="22-b" value="&lt;table style='border-collapse:collapse;font-size:12px;width:100%'&gt;&lt;tr&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Vai trò&lt;/th&gt;&lt;th style='border:1px solid #888;padding:4px 8px;background:#eef;text-align:left'&gt;Mức phụ thuộc&lt;/th&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Orderbook — nơi filler và người dùng gặp nhau&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Bắt buộc có lớp chia sẻ&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Relayer — claim hộ, trả gas chain đích&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Tiện lợi; backend dừng thì người dùng tự claim&lt;/td&gt;&lt;/tr&gt;&lt;tr&gt;&lt;td style='border:1px solid #888;padding:4px 8px;font-weight:bold;'&gt;Watcher — theo dõi trạng thái, verify escrow&lt;/td&gt;&lt;td style='border:1px solid #888;padding:4px 8px;'&gt;Tiện lợi; frontend tự làm được&lt;/td&gt;&lt;/tr&gt;&lt;/table&gt;&lt;p style='font-size:13px'&gt;Phần lõi phi tập trung nằm ở smart contract; backend chủ yếu phục vụ trải nghiệm.&lt;/p&gt;" style="text;html=1;fontSize=14;align=left;verticalAlign=top;whiteSpace=wrap;spacingLeft=4;" vertex="1" parent="1"><mxGeometry x="50" y="115" width="1180" height="565" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>