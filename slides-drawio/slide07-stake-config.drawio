        <mxCell id="pb1" value="&gt; 50 block          —          1×" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE5;fontColor=#333333;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
