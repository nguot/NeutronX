        <!-- ============ WORKED EXAMPLE ============ -->
        <mxCell id="ex" value="Ví dụ — order 5 ETH, còn 8 block:   rate 50%  ×  mult 3×   →   stake = 7.5 ETH.     Nếu filler chỉ fill 20% cam kết rồi bỏ  →  hoàn 20% = 1.5 ETH,  MẤT 6 ETH." style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#C89B2E;strokeWidth=2;fontColor=#8A6D1A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
