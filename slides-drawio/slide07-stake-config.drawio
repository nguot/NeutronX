<mxfile host="app.diagrams.net">
  <diagram id="slide07" name="Slide 7 - DynamicStakeLib config">
    <mxGraphModel dx="1500" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="740" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ HEADLINE ============ -->
        <mxCell id="head" value="Không whitelist ai cả — thay bằng STAKE (đặt cọc).  Muốn khớp phải stake.  Ôm order rồi bỏ → MẤT stake." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#16305C;strokeColor=none;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1400" height="56" as="geometry" />
        </mxCell>
        <mxCell id="formula" value="stake  =  giá trị order (notional)  ×  rate(size)  ×  multiplier(thời gian còn lại)          —  có sàn tối thiểu minCollateral" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#16305C;strokeWidth=2;fontColor=#16305C;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="120" width="1400" height="50" as="geometry" />
        </mxCell>

        <!-- ============ PANEL A: rate theo size ============ -->
        <mxCell id="pa_h" value="rate theo ORDER SIZE" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#16305C;strokeColor=#16305C;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="200" width="440" height="42" as="geometry" />
        </mxCell>
        <mxCell id="pa1" value="&lt; 1 ETH          —          20%" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE5;fontColor=#333333;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="242" width="440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pa2" value="1 – 10 ETH          —          50%" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE5;fontColor=#333333;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="282" width="440" height="40" as="geometry" />
        </mxCell>
        <mxCell id="pa3" value="10 – 100 ETH          —          100%" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE5;fontColor=#333333;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="322" width="440" height="40" as="geometry" />
