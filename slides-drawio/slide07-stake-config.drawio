        <mxCell id="pa4" value="&gt; 100 ETH          —          300%" style="whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#D5DAE5;fontColor=#333333;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="362" width="440" height="40" as="geometry" />
        </mxCell>

        <!-- ============ PANEL B: multiplier theo time ============ -->
