        <!-- ============ NGUYEN LY ============ -->
        <mxCell id="phead" value="Nguyên lý: một secret S mở được cả hai escrow — nhưng mỗi hàm chỉ trả cho MỘT bên cố định" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#16305C;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="55" width="1360" height="46" as="geometry" />
        </mxCell>
        <mxCell id="p1" value="EscrowSrc.withdraw(S)   →   INPUT cho FILLER" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16305C;strokeWidth=2;fontColor=#16305C;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="190" y="113" width="500" height="52" as="geometry" />
        </mxCell>
        <mxCell id="p2" value="EscrowDst.claim(S)   →   OUTPUT cho SWAPPER" style="rounded=1;arcSize=14;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16305C;strokeWidth=2;fontColor=#16305C;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="790" y="113" width="500" height="52" as="geometry" />
        </mxCell>

        <!-- ============ ABOVE-LINE WINDOWS ============ -->
        <mxCell id="wReveal" value="Filler withdraw(S): lấy input, LỘ S&#10;(reveal càng sớm càng tốt)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#16305C;strokeWidth=1;fontColor=#16305C;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="185" y="250" width="510" height="70" as="geometry" />
        </mxCell>
        <mxCell id="wBuffer" value="buffer T2 − T1 : cửa sổ để swapper claim(S) → output&#10;(claim phải kịp FINAL trước T2)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#C89B2E;strokeWidth=2;fontColor=#8A6D1A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
