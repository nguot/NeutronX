        </mxCell>
        <mxCell id="refund" value="quá T2 → refund EscrowDst&#10;(chỉ filler)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F5FA;strokeColor=#9FB6D9;strokeWidth=1;fontColor=#5B6472;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1000" y="415" width="360" height="62" as="geometry" />
        </mxCell>

        <!-- ============ FAILURE CASES ============ -->
        <mxCell id="fc2" value="Swapper rút T1 quá ngắn  →  filler không kịp reveal an toàn&#10;→  FILLER KHÔNG VÀO LỆNH  (mất gas; swapper không được gì)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0F6;strokeColor=#16305C;strokeWidth=1;fontColor=#16305C;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="60" y="515" width="660" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fc1" value="Filler đặt T2 quá gần T1  →  buffer quá nhỏ  →  swapper không kịp claim&#10;→  SWAPPER TỪ CHỐI KÝ  (verify — Điểm A)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EEF0F6;strokeColor=#16305C;strokeWidth=1;fontColor=#16305C;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="515" width="660" height="90" as="geometry" />
        </mxCell>

        <!-- ============ INCENTIVE ALIGNMENT ============ -->
        <mxCell id="inc" value="Động cơ căn chỉnh:  quá T1 là filler mất input + bond  →  filler luôn reveal CÀNG SỚM CÀNG TỐT  →  swapper càng dư thời gian claim.        Lợi ích filler  ≡  an toàn swapper." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF3EA;strokeColor=#2E7D32;strokeWidth=2;fontColor=#2E7D32;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
