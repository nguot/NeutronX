        <!-- ============ BELOW-LINE FALLBACK ============ -->
        <mxCell id="cancel" value="quá T1 chưa lộ S → cancel EscrowSrc&#10;→ swapper hoàn INPUT + BOND" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FBEDEE;strokeColor=#C8102E;strokeWidth=1;fontColor=#C8102E;fontSize=13;align=center;verticalAlign=middle;" vertex="1" parent="1">
