<mxfile host="app.diagrams.net">
  <diagram id="arch" name="Kien truc - Off-chain / On-chain">
    <mxGraphModel dx="1500" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1420" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============== CONTAINER OFF-CHAIN ============== -->
        <mxCell id="off" value="OFF-CHAIN" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#EEF0F6;strokeColor=#C6CBD9;strokeWidth=1;verticalAlign=top;align=center;fontSize=18;fontStyle=1;fontColor=#16305C;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="40" y="60" width="560" height="700" as="geometry" />
        </mxCell>
        <mxCell id="fe" value="Frontend&#10;Tạo &amp; ký lệnh · Theo dõi" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB6D9;strokeWidth=1;fontColor=#333333;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="140" width="250" height="90" as="geometry" />
        </mxCell>
        <mxCell id="fl" value="Filler&#10;giữ secret S (cross-chain)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16305C;strokeWidth=2;fontColor=#16305C;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="360" y="280" width="210" height="90" as="geometry" />
        </mxCell>
        <mxCell id="be" value="BACKEND&#10;&#10;Lưu order cho swapper&#10;Cosigner — chỉ single-chain&#10;Watcher Src/Dst · Relayer · PostgreSQL" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#16305C;strokeColor=none;fontColor=#FFFFFF;fontSize=16;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="100" y="560" width="430" height="170" as="geometry" />
        </mxCell>

        <!-- ============== CONTAINER ON-CHAIN ============== -->
        <mxCell id="onc" value="ON-CHAIN" style="rounded=1;arcSize=1;whiteSpace=wrap;html=1;fillColor=#E7ECF5;strokeColor=#C6CBD9;strokeWidth=1;verticalAlign=top;align=center;fontSize=18;fontStyle=1;fontColor=#16305C;spacingTop=14;" vertex="1" parent="1">
          <mxGeometry x="680" y="60" width="700" height="700" as="geometry" />
        </mxCell>

        <!-- Single-chain group -->
        <mxCell id="sc" value="SINGLE-CHAIN SWAP" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#F3F5FA;strokeColor=#9FB6D9;strokeWidth=1;verticalAlign=top;align=center;fontSize=15;fontStyle=1;fontColor=#16305C;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="710" y="120" width="640" height="230" as="geometry" />
        </mxCell>
        <mxCell id="pfr" value="PartialFillReactor" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#16305C;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="750" y="180" width="270" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fa" value="FillAuction" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#16305C;strokeColor=none;fontColor=#FFFFFF;fontSize=16;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1080" y="180" width="230" height="70" as="geometry" />
        </mxCell>
        <mxCell id="fbe" value="FallbackExecutor — route phần dư gần deadline" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB6D9;strokeWidth=1;fontColor=#333333;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="750" y="278" width="560" height="52" as="geometry" />
        </mxCell>
        <mxCell id="e_pf" value="onFillSuccess / stake" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;endArrow=block;endFill=1;strokeColor=#C8102E;strokeWidth=2;fontSize=13;fontColor=#C8102E;labelBackgroundColor=#F3F5FA;" edge="1" parent="1" source="pfr" target="fa">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- Cross-chain group -->
        <mxCell id="cc" value="CROSS-CHAIN SWAP  (HTLC · filler giữ key)" style="rounded=1;arcSize=3;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#16305C;strokeWidth=2;verticalAlign=top;align=center;fontSize=15;fontStyle=1;fontColor=#16305C;spacingTop=10;" vertex="1" parent="1">
          <mxGeometry x="710" y="400" width="640" height="320" as="geometry" />
        </mxCell>
        <mxCell id="esf" value="EscrowSrcFactory&#10;(Chain A — input swapper + bond)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16305C;strokeWidth=1;fontColor=#16305C;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="745" y="465" width="290" height="90" as="geometry" />
        </mxCell>
        <mxCell id="edf" value="EscrowDstFactory&#10;(Chain B — output filler)" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#16305C;strokeWidth=1;fontColor=#16305C;fontSize=15;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="1075" y="465" width="235" height="90" as="geometry" />
        </mxCell>
        <mxCell id="ccnote" value="Filler fund EscrowDst → swapper verify &amp; ký FillAuth → fillSlot khoá EscrowSrc → withdraw lộ secret → relayer claim EscrowDst&#10;(chi tiết ở sơ đồ &quot;Cross-chain flow&quot;)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F5FA;strokeColor=#9FB6D9;strokeWidth=1;fontColor=#5B6472;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="745" y="585" width="565" height="105" as="geometry" />
        </mxCell>

        <!-- ============== EDGES OFF-CHAIN ============== -->
        <mxCell id="e1" value="① swapper tạo &amp; ký order (EIP-712)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16305C;strokeWidth=2;fontSize=13;fontColor=#16305C;labelBackgroundColor=#EEF0F6;" edge="1" parent="1" source="fe" target="be">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e2" value="công bố order · chuyển FillAuth" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16305C;strokeWidth=2;fontSize=13;fontColor=#16305C;labelBackgroundColor=#EEF0F6;" edge="1" parent="1" source="be" target="fl">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============== EDGES OFF to ON ============== -->
        <mxCell id="e3" value="single-chain: register · executePartialChunk" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16305C;strokeWidth=2;fontSize=13;fontColor=#16305C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.3;exitDx=0;exitDy=0;" edge="1" parent="1" source="fl" target="pfr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e4" value="cross-chain: fund → fillSlot → reveal" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;strokeColor=#16305C;strokeWidth=2;fontSize=13;fontColor=#16305C;labelBackgroundColor=#FFFFFF;exitX=1;exitY=0.75;exitDx=0;exitDy=0;entryX=0;entryY=0.15;entryDx=0;entryDy=0;" edge="1" parent="1" source="fl" target="cc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e5" value="watcher Src/Dst · relayer claim(S)" style="edgeStyle=orthogonalEdgeStyle;rounded=1;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#8A93A6;strokeWidth=2;fontSize=13;fontColor=#5B6472;labelBackgroundColor=#FFFFFF;entryX=0;entryY=0.6;entryDx=0;entryDy=0;" edge="1" parent="1" source="be" target="cc">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
