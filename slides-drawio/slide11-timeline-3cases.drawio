        <!-- ============================= KET LUAN: huong tan cong con lai ============================= -->
        <mxCell id="atk_head" value="⇒  HƯỚNG TẤN CÔNG DUY NHẤT CÒN LẠI  —  ép chain đích REORG (tổ chức lại chuỗi)" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#16305C;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="30" y="730" width="1180" height="46" as="geometry" /></mxCell>
        <mxCell id="atk_body" value="Mọi cách trên đều bị chặn bằng động cơ kinh tế. Còn lại: đảo ngược giao dịch claim đã final trên chain đích và giữ trạng thái đó quá buffer (T2 − T1).&#10;→ Đây là một cú đảo finality ở tầng đồng thuận. Trên chain finality mạnh (Ethereum PoS: cần ≥ ⅓ tổng stake bị slash — hàng tỉ USD) là bất khả thi về kinh tế;&#10;chain finality yếu hơn thì chỉ cần đặt buffer dài hơn.        ⟹ An toàn quy về một tham số duy nhất: buffer ≥ finality của từng chain." style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#16305C;strokeWidth=2;fontColor=#16305C;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1"><mxGeometry x="30" y="782" width="1180" height="96" as="geometry" /></mxCell>

      </root>
