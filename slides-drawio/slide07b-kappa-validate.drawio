<mxfile host="app.diagrams.net">
  <diagram id="slide07b" name="Slide 7b - Kappa and config hop le">
    <mxGraphModel dx="1500" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="760" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- ============ COLUMN TITLES ============ -->
        <mxCell id="lt" value="Cách tính ngưỡng κ (worst-case)" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#16305C;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="70" width="680" height="34" as="geometry" />
        </mxCell>
        <mxCell id="rt" value="Điều kiện config HỢP LỆ — validate()" style="text;html=1;fillColor=none;strokeColor=none;fontColor=#16305C;fontSize=17;fontStyle=1;align=left;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="70" width="680" height="34" as="geometry" />
        </mxCell>

        <!-- ============ LEFT: kappa derivation ============ -->
        <mxCell id="b1" value="Filler snipe = fill x% rồi BỎ.&#10;Có LỜI khi:   chênh giá ăn được  &gt;  cọc bị tịch thu&#10;&#10;x · N · κ   &gt;   S · (1 − φ)&#10;&#10;N = notional · S = stake · φ = tỉ lệ hoàn cọc · κ = chênh giá (edge)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB6D9;strokeWidth=1;fontColor=#333333;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="116" width="680" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="Breakeven (lời = 0)  ⟹  chênh giá tối thiểu để snipe hoà vốn:&#10;&#10;κ (bps)  =  collateralRate × timeMult × penalty  ÷  (10000 × x)&#10;&#10;penalty = 10000 − refund_bps      ·      x = mép bucket bị phạt cuối cùng" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#EAF1FB;strokeColor=#16305C;strokeWidth=2;fontColor=#16305C;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="266" width="680" height="120" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="κ_worst  =  MIN κ  qua MỌI ( size bucket × time bucket × ratio bucket )&#10;→ chính là điểm DỄ snipe nhất của config" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB6D9;strokeWidth=1;fontColor=#333333;fontSize=14;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="416" width="680" height="80" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="⟹  Config chỉ được chấp nhận nếu   κ_worst  ≥  1000 bps  (10%)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#16305C;strokeColor=none;fontColor=#FFFFFF;fontSize=15;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="526" width="680" height="60" as="geometry" />
        </mxCell>

        <mxCell id="a12" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#16305C;strokeWidth=2;" edge="1" parent="1" source="b1" target="b2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a23" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#16305C;strokeWidth=2;" edge="1" parent="1" source="b2" target="b3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="a34" style="edgeStyle=none;html=1;endArrow=block;endFill=1;strokeColor=#16305C;strokeWidth=2;" edge="1" parent="1" source="b3" target="b4">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <!-- ============ RIGHT: validity conditions ============ -->
        <mxCell id="rl" value="①  Đúng hình chữ nhật:  S = size+1 · T = time+1 · refundTable = S × R&#10;&#10;②  Số bucket có chặn:  1 ≤ S, T, R ≤ maxBuckets&#10;&#10;③  Ngưỡng đúng thứ tự:  size ↑ · ratio ↑ · time ↓ (block còn lại)&#10;&#10;④  Rate trong [minRate, maxRate]   (rate = 0 → cọc miễn phí → cấm)&#10;&#10;⑤  Mỗi hàng refund KHÔNG giảm &amp; kết thúc đúng 100%" style="rounded=1;arcSize=6;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#9FB6D9;strokeWidth=1;fontColor=#333333;fontSize=14;align=left;verticalAlign=middle;spacingLeft=18;" vertex="1" parent="1">
          <mxGeometry x="760" y="116" width="680" height="270" as="geometry" />
        </mxCell>
        <mxCell id="r6" value="⑥  κ_worst ≥ 10%   —  NGƯỠNG KINH TẾ (invariant quan trọng nhất)" style="rounded=1;arcSize=10;whiteSpace=wrap;html=1;fillColor=#16305C;strokeColor=none;fontColor=#FFFFFF;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="760" y="400" width="680" height="52" as="geometry" />
        </mxCell>
        <mxCell id="rg" value="Khi SỬA config lúc runtime (governance):  guardCheck() — chỉ được nới lỏng trong giới hạn maxDeltaBps, có sàn minPenaltyBps; phải qua cooldown + guardian có thể phủ quyết / rollback." style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#F3F5FA;strokeColor=#9FB6D9;strokeWidth=1;fontColor=#5B6472;fontSize=13;align=left;verticalAlign=middle;spacingLeft=16;" vertex="1" parent="1">
          <mxGeometry x="760" y="470" width="680" height="116" as="geometry" />
        </mxCell>

        <!-- ============ WORKED EXAMPLE ============ -->
        <mxCell id="ex" value="VÍ DỤ (config mặc định) — điểm dễ snipe nhất:  order nhỏ (rate 20%) · còn nhiều thời gian (mult 1×) · dừng sát mép 70%&#10;penalty = 10000 − 5000 = 5000 ;   x = 7000    →    κ = 2000 × 10000 × 5000 ÷ (10000 × 7000)  ≈  1429 bps  ≈  14.3%&#10;→ filler phải ăn &gt; 14% chênh giá mới có lời  →  phi thực tế  →  AN TOÀN  (≥ 10%)" style="rounded=1;arcSize=8;whiteSpace=wrap;html=1;fillColor=#FFF3D6;strokeColor=#C89B2E;strokeWidth=2;fontColor=#8A6D1A;fontSize=14;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
          <mxGeometry x="40" y="620" width="1400" height="110" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
