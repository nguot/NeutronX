        <mxCell id="SF3" value="previewRequiredStake()" style="whiteSpace=wrap;html=1;fillColor=#F3F5FA;strokeColor=#D5DAE5;align=left;verticalAlign=middle;spacingLeft=14;fontSize=14;fontColor=#16305C;" vertex="1" parent="SF"><mxGeometry x="10" y="120" width="540" height="30" as="geometry" /></mxCell>
        <mxCell id="SF4" value="computeAddress()  ·  isFilled()   [view]" style="whiteSpace=wrap;html=1;fillColor=#EEF0F6;strokeColor=#D5DAE5;align=left;verticalAlign=middle;spacingLeft=14;fontSize=13;fontColor=#5B6472;fontStyle=2;" vertex="1" parent="SF"><mxGeometry x="10" y="156" width="540" height="30" as="geometry" /></mxCell>
        <mxCell id="SF5" value="remainingInput()  ·  stakeConfig()   [view]" style="whiteSpace=wrap;html=1;fillColor=#EEF0F6;strokeColor=#D5DAE5;align=left;verticalAlign=middle;spacingLeft=14;fontSize=13;fontColor=#5B6472;fontStyle=2;" vertex="1" parent="SF"><mxGeometry x="10" y="192" width="540" height="30" as="geometry" /></mxCell>

        <!-- ================= EscrowSrc ================= -->
