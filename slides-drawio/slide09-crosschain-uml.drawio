        <mxCell id="SF" value="EscrowSrcFactory" style="swimlane;html=1;startSize=40;rounded=1;arcSize=4;fillColor=#16305C;swimlaneFillColor=#FFFFFF;strokeColor=#16305C;fontColor=#FFFFFF;fontSize=17;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1">
