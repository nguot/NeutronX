        <mxCell id="ES2" value="withdraw(secret)   → filler (input + bond), LỘ S" style="whiteSpace=wrap;html=1;fillColor=#F3F5FA;strokeColor=#D5DAE5;align=left;verticalAlign=middle;spacingLeft=14;fontSize=14;fontColor=#16305C;" vertex="1" parent="ES"><mxGeometry x="10" y="84" width="540" height="30" as="geometry" /></mxCell>
        <mxCell id="ES3" value="cancel()   sau T1 → swapper (input + bond)" style="whiteSpace=wrap;html=1;fillColor=#F3F5FA;strokeColor=#D5DAE5;align=left;verticalAlign=middle;spacingLeft=14;fontSize=14;fontColor=#16305C;" vertex="1" parent="ES"><mxGeometry x="10" y="120" width="540" height="30" as="geometry" /></mxCell>
