<mxfile host="app.diagrams.net">
  <diagram id="ccuml" name="Cross-chain contracts UML">
    <mxGraphModel dx="1500" dy="900" grid="0" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1480" pageHeight="720" math="0" shadow="0">
      <root>
        <mxCell id="0" /><mxCell id="1" parent="0" />

        <mxCell id="lblA" value="CHAIN A  (nguồn — token swapper)" style="text;html=1;fontColor=#16305C;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="40" y="34" width="500" height="26" as="geometry" /></mxCell>
        <mxCell id="lblB" value="CHAIN B  (đích — token filler)" style="text;html=1;fontColor=#16305C;fontSize=15;fontStyle=1;align=left;" vertex="1" parent="1"><mxGeometry x="880" y="34" width="500" height="26" as="geometry" /></mxCell>

