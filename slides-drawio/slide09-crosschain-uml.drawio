        <!-- ================= Oracle + Lib (bond, Chain A) ================= -->
        <mxCell id="O" value="UniswapV3NotionalOracle&#10;quoteEthNotional()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#C89B2E;strokeWidth=2;fontColor=#8A6D1A;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="326" width="220" height="72" as="geometry" /></mxCell>
        <mxCell id="LIB" value="DynamicStakeLib&#10;requiredStakeByTimestamp()" style="rounded=1;arcSize=12;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#4A5C82;strokeWidth=2;fontColor=#4A5C82;fontSize=13;fontStyle=1;align=center;verticalAlign=middle;" vertex="1" parent="1"><mxGeometry x="640" y="180" width="220" height="72" as="geometry" /></mxCell>

